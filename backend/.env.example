# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

DATABASE_URL=postgresql://user:password@localhost:5432/ditdik_db

SECRET_KEY=changeme_use_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ALLOWED_ORIGINS=["http://localhost:3000"]

# config for email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@email.com
# Gmail requires a 16-character App Password (Google Account > Security > App Passwords)
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your.email.@gmail.com
SMTP_FROM_NAME=AutoSix
FRONTEND_URL=http://localhost:3000